{
  "name": "pa-zzle-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "biome check --write .",
    "semantic-lint": "bun ../tools/semantic-lint/cli/main.ts",
    "semantic-lint:typecheck": "tsc -p ../tools/semantic-lint/tsconfig.json",
    "semantic-lint:eval": "bun ../tools/semantic-lint/cli/main.ts eval",
    "semantic-lint:test": "bun test ../tools/semantic-lint"
  },
  "dependencies": {
    "@generouted/react-router": "^1.20.2",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7.18.3",
    "recharts": "3.8.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "@typescript/typescript6": "6.0.2"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
