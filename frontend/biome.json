{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": ["**", "!node_modules", "!dist", "!src/router.ts"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "off",
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        }
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/lib/**/*.{ts,tsx}", "!**/*.test.{ts,tsx,mjs}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/components/**",
                      "**/components/**",
                      "@/games/**",
                      "**/games/**",
                      "@/records/**",
                      "**/records/**",
                      "@/pages/**",
                      "**/pages/**",
                      "@/router",
                      "**/router"
                    ],
                    "message": "lib はアプリ固有の上位責務へ依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/ui/**/*.{ts,tsx}",
        "!**/*.test.{ts,tsx,mjs}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/games/**",
                      "**/games/**",
                      "@/records/**",
                      "**/records/**",
                      "@/pages/**",
                      "**/pages/**",
                      "@/router",
                      "**/router"
                    ],
                    "message": "汎用UIはゲーム・記録・ページへ依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/components/**/*.{ts,tsx}",
        "!src/components/ui/**",
        "!**/*.test.{ts,tsx,mjs}"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/games/*/**",
                      "@/records/**",
                      "**/records/**",
                      "@/pages/**",
                      "**/pages/**"
                    ],
                    "message": "共通コンポーネントは具体ゲーム・記録・ページへ依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/games/problem-seed.ts", "src/games/result.ts"],
