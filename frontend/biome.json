{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "files": {
    "includes": [
      "**",
      "!node_modules",
      "!dist",
      "!src/router.ts",
      "!src/components/ui",
      "!src/games/minesweeper/problem/problem-pool.json",
      "!src/games/water-sort/problem/problem-pool.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": "off",
      "suspicious": {
        "noAssignInExpressions": "off",
        "noImportCycles": {
          "level": "error",
          "options": {
            "ignoreTypes": false
          }
        }
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "noDefaultExport": "error"
      },
      "correctness": {
        "noUnusedFunctionParameters": "off",
        "noNestedComponentDefinitions": "error"
      },
      "nursery": {
        "useReactFunctionComponentDefinition": {
          "level": "error",
          "options": {
            "namedComponents": "functionDeclaration"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "[dependency/absolute-import] frontend/src 内の内部参照は @/... の絶対 import を使う。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/pages/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "[dependency/absolute-import] frontend/src 内の内部参照は @/... の絶対 import を使う。"
                  },
                  {
                    "group": [
                      "@/components/**",
                      "@/games/**",
                      "@/lib/**",
                      "@/records/**"
                    ],
                    "message": "[dependency/pages-boundary] pages はルートと View の対応だけを持ち、画面の依存は View が合成する。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/views/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "[dependency/absolute-import] frontend/src 内の内部参照は @/... の絶対 import を使う。"
                  },
                  {
                    "group": ["@/pages/**"],
                    "message": "[dependency/views-boundary] View は画面合成境界であり pages へ逆依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "[dependency/absolute-import] frontend/src 内の内部参照は @/... の絶対 import を使う。"
                  },
                  {
                    "group": [
                      "@/games/*/**",
                      "@/records/**",
                      "@/views/**",
                      "@/pages/**"
                    ],
                    "message": "[dependency/app-boundary] app はアプリ全体の責務だけを持ち、具体ゲーム・記録・画面合成へ依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/ui/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "[dependency/absolute-import] frontend/src 内の内部参照は @/... の絶対 import を使う。"
                  },
                  {
                    "group": [
                      "@/app/**",
                      "@/games/**",
                      "@/records/**",
                      "@/views/**",
                      "@/pages/**",
                      "@/router"
                    ],
                    "message": "[dependency/ui-boundary] UI 基盤はアプリ固有の責務・ルーティングへ依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**/*.{ts,tsx}", "!src/components/ui"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "[dependency/absolute-import] frontend/src 内の内部参照は @/... の絶対 import を使う。"
                  },
                  {
                    "group": ["@/records/**", "@/views/**", "@/pages/**"],
                    "message": "[dependency/legacy-components-boundary] 共有コンポーネントは記録・画面合成・pages へ逆依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/**/*.{ts,tsx}"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["./**", "../**"],
                    "message": "[dependency/absolute-import] frontend/src 内の内部参照は @/... の絶対 import を使う。"
                  },
                  {
                    "group": [
                      "@/app/**",
                      "@/components/**",
                      "@/games/**",
                      "@/records/**",
                      "@/views/**",
                      "@/pages/**",
                      "@/router",
                      "react*"
                    ],
                    "message": "[dependency/legacy-lib-boundary] lib はアプリ固有責務・React・ルーティングへ依存しない。"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/games/*.{ts,tsx}"],
